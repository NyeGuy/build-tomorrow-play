---
import { TECH_FUND_URL, DEADLINE_TEXT } from '../config';
import Button from './Button.astro';

interface Props {
  ctaLabel?: string;
  ctaHref?: string;
  external?: boolean;
}

const {
  ctaLabel = 'Give Now',
  ctaHref = TECH_FUND_URL,
  external = true,
} = Astro.props;
---

<section class="section-rule mt-16 py-12 md:py-16">
  <div class="page-gutter flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <p class="max-w-xl text-mute text-lg md:text-xl">
      Every dollar goes to the classroom. The show is {DEADLINE_TEXT}.
    </p>
    <Button href={ctaHref} external={external}>{ctaLabel}</Button>
  </div>
</section>
