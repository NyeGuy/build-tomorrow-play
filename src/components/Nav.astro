---
import { TECH_FUND_URL } from '../config';
import Button from './Button.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
  { href: '/technology/', label: 'Technology Fund', id: '/technology' },
  { href: '/designtomorrow/', label: 'Design Tomorrow', id: '/designtomorrow' },
  { href: '/give/', label: 'Hardware & Compute', id: '/give' },
];
---

<header class="border-b border-rule">
  <div class="page-gutter flex flex-col gap-4 py-4 md:flex-row md:items-center md:justify-between md:py-5">
    <a
      href="/"
      class="font-black tracking-[0.12em] uppercase text-sm md:text-base text-ink no-underline hover:text-accent"
    >
      Build Tomorrow
    </a>
    <nav aria-label="Primary" class="flex flex-wrap items-center gap-x-5 gap-y-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-semibold no-underline hover:text-accent',
              path === link.id ? 'text-accent' : 'text-mute',
            ]}
            aria-current={path === link.id ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <Button href={TECH_FUND_URL} external class="ml-0 md:ml-2">
        Donate
      </Button>
    </nav>
  </div>
</header>
